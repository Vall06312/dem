<Window x:Class="dem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Вход" Height="440" Width="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="15"
        Background="White" Icon="Images/Icon.ico">
    <StackPanel>
        <Border Background="#7FFF00" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="Images/Icon.png" Height="50" Stretch="Uniform"/>
                <TextBlock Text="ООО «Обувь»" FontSize="24" FontWeight="Bold" Foreground="#1E3A00" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="30">
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="tbLogin"/>
            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="tbPassword"/>
            <Button Content="Войти" Background="#00FA9A" Margin="3,8,3,0" FontWeight="Bold" Height="36" Click="Login"/>
            <Button Content="Войти как гость" Margin="3,8,3,0" Click="Guest"/>
            <Button Content="Выход" Margin="3,8,3,0" Click="Exit"/>
        </StackPanel>
    </StackPanel>
</Window>